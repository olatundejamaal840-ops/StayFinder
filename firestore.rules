rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin is the master account (see authService.js), verified by email.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'devcohort77@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /properties/{propertyId} {
      // Public can read published listings; owners see their own; admin sees all.
      allow read: if resource.data.listingStatus == 'published'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      // New listings must belong to the caller and start unverified.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.listingStatus == 'pending_verification'
        && request.resource.data.isFeatured == false;

      // Admin moderates; owners may edit but not touch moderation fields.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.verificationStatus == resource.data.verificationStatus
            && request.resource.data.listingStatus == resource.data.listingStatus
            && request.resource.data.isFeatured == resource.data.isFeatured);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
